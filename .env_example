# vLLM API 配置
# vLLM 服务的完整 API URL，包含协议、主机和路径
# 格式: http://host:port/v1 或 https://host:port/v1
VLLM_API_URL=http://192.168.1.197:6800/v1

# vLLM API 密钥（可选，如果服务需要认证）
VLLM_API_KEY=sk-yourverystrongrandomkey1234567890abcdef

# vLLM 模型名称（可选，如果不指定则使用服务默认模型）
VLLM_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-FP8

# 是否启用 thinking 输出（可选，默认为 true）
# true: 允许模型进行推理思考，可能提高输出质量，但会生成更多内容
# false: 禁用 thinking 输出，输出更简洁，但可能影响推理质量
# 注意：即使启用 thinking，结构化输出也会自动只提取最终结果，thinking 内容不会保存到 JSON
VLLM_ENABLE_THINKING=true

# 最大生成 token 数（可选，默认 100000，模型支持最大 1000000）
# 根据模型能力调整，nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-FP8 支持最大 1M tokens
VLLM_MAX_TOKENS=1000000

# 索引服务 API URL（用于向量数据库或索引服务，未来功能）
# 格式: http://host:port 或 https://host:port
INDEX_API_URL=http://192.168.1.197:6802
